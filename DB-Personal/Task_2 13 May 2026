SELECT 
 c.contact_date as "Contact Date ",
 c.id as "Contact Id",
from ecrm.contacts
join ecrm.materials ms on ecrm.contacts c.giveable = ms.id
where campaign_id = 161;





SELECT 
    c.contact_date AS "Contact Date",
    COUNT(c.giveable) AS "Total giveable",
   -- COUNT( c.consumer_id) AS "Total  Consumers",
    m.name  AS "Materials Given"
FROM ecrm.contacts c
LEFT JOIN ecrm.materials m ON c.giveable = m.id 
WHERE c.campaign_id = 161
     AND c.contact_date >= '2025-10-20'
GROUP BY c.contact_date ,m.name
ORDER BY c.contact_date DESC
LIMIT 500;


