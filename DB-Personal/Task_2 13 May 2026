-- Find Count of consumer. how many of them are Fresh Consumer. if true fresh consumer ,if false 'not fresh consumer'.
--campaign 161 
--date range 2025-10-20 to till date
-- Solution 
SELECT 
    consumer_id,
    contact_date,
    CASE 
        WHEN additional_info::jsonb ->> 'fresh_consumer' = 'true' THEN 'Fresh Consumer' ELSE 'Not Fresh Consumer'
    END AS consumer_status
FROM ecrm.contacts
WHERE campaign_id = 161
    AND contact_date >= '2025-10-20'
    AND is_deleted = false
ORDER BY contact_date;


